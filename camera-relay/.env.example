# ─── Camera Relay Environment Variables ────────────────────────────────────
# Copy this file to .env and fill in your values.

# Port the HLS relay HTTP server will listen on
PORT=9001

# Provide up to 4 RTSP stream URLs for the 2x2 grid.
# If you only provide RTSP_URL_1, only 1 camera will be streamed.
# For lower CPU usage and better performance on the 4-grid view, 
# use your NVR's "Sub-Stream" (lower resolution/bitrate) URLs if available.

# Example: rtsp://admin:Admin@1234@192.168.1.64:554/Streaming/Channels/101
RTSP_URL_1=rtsp://admin:Aipl@7MGD@192.168.1.64:554/stream
RTSP_URL_2=rtsp://admin:Aipl@7MGD@192.168.1.64:554/stream
RTSP_URL_3=rtsp://admin:Aipl@7MGD@192.168.1.64:554/stream
RTSP_URL_4=rtsp://admin:Aipl@7MGD@192.168.1.64:554/stream

# (Optional) Path to ffmpeg binary if not in PATH
# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
