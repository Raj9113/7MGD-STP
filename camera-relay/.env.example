# ─── Camera Relay Environment Variables ────────────────────────────────────
# Copy this file to .env and fill in your values.

# RTSP stream URL from your IP camera
# Format: rtsp://username:password@camera-ip:port/stream-path
# Example: rtsp://admin:Admin@1234@192.168.1.64:554/Streaming/Channels/101
RTSP_URL=rtsp://admin:password@192.168.1.64:554/stream

# Port the HLS relay HTTP server will listen on
PORT=3001

# (Optional) Path to ffmpeg binary if not in PATH
# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
