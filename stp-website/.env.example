NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Live camera HLS stream URL (from your Cloudflare Tunnel pointing to camera-relay)
# Server-side only — never exposed to the browser (no NEXT_PUBLIC_ prefix)
CAMERA_HLS_URL=https://camera.yourdomain.com/stream/stream.m3u8

